# Production Environment Variables (Default)
# Copy this to .env and fill in your production values

# ðŸŒ Your Domain (CHANGE THIS!)
NEXTAUTH_URL=https://yourdomain.com
# Origin the server uses to call its own API routes (Steam lookups go through
# /api/steam). Defaults to http://127.0.0.1:$PORT, which is what you want:
# routing internal calls through NEXTAUTH_URL sends them out to the public
# hostname and back, which needs hairpin NAT and can be rate limited or
# challenged by a tunnel/CDN. Only set this if the app runs under a basePath or
# on a non-default interface.
# INTERNAL_APP_URL=http://127.0.0.1:3000

# Python backend (rewrite in progress). The Next middleware proxies ported /api
# paths to BACKEND_INTERNAL_URL and signs each with INTERNAL_API_SECRET; the
# FastAPI backend rejects anything without the matching secret. Generate a long
# random value and set the SAME one for both containers. The backend port is
# never published, so only the Next container can reach it.
# BACKEND_INTERNAL_URL=http://backend:8000
# INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Optional: MONGODB_DB if the name is not encoded in MONGODB_URI.
# MONGODB_DB=aiogames

# ðŸ” Authentication Secret (GENERATE A STRONG SECRET!)
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-change-this-in-production

# ðŸ“Š MongoDB Atlas Connection (RECOMMENDED FOR PRODUCTION)
# Get this from your MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aiogames?retryWrites=true&w=majority

# ï¿½ Owner User (Created at startup - Full admin access + user management)
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=change-this-secure-password
OWNER_NAME=Owner

# ï¿½ðŸ‘¤ Admin User (Will be created automatically - Can manage games and ban users)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-secure-password
ADMIN_NAME=Admin User

# ðŸ“± Telegram Bot (Shared bot for all users)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
# Users only need to provide their Telegram username or user ID to receive notifications

# ðŸ›¡ï¸ FlareSolverr (Cloudflare bypass for skidrow/steamrip)
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Network timeouts for outbound game-source scraping
# End-to-end ceiling (ms) for `siteFetch()` via `AbortSignal.timeout`.
# SITE_FETCH_TIMEOUT_MS=60000
# TCP connect timeout for the minimal undici dispatcher (`src/lib/gameapi/net.ts`).
# This only controls socket connect; per-request duration is still controlled
# by SITE_FETCH_TIMEOUT_MS.
# SITE_CONNECT_TIMEOUT_MS=60000
#
# Outbound IPv4-only (recommended on VPS with broken IPv6 routing).
# Default is on: undici global `fetch` uses `family: 4` and DNS prefers A
# records. Set to 0/false/off to allow IPv6 again.
# FORCE_IPV4=1
#
# FlareSolverr request timeout (ms). FlareSolverr renders a browser to
# solve CF challenges, which can easily take >30s on a cold session.
# FLARE_TIMEOUT_MS=60000
# FLARE_RETRIES=2

# Circuit breaker tuning for Skidrow / DODI
# How long the circuit stays open after the failure threshold is reached.
# SKIDROW_COOLDOWN_MS=60000
# DODI_COOLDOWN_MS=60000
# How many consecutive failures trip the breaker. Defaults to 2 so a single
# transient blip doesn't block the site for the whole cooldown.
# SKIDROW_FAILURE_THRESHOLD=2
# DODI_FAILURE_THRESHOLD=2

# ðŸ” Recent-uploads auto-recovery (per-site verified/unverified ratios)
# The /api/games/recent route tracks per-site stats and auto-triggers two
# kinds of background recovery when the cached grid looks unhealthy:
#
#   1. Empty-site refresh â€” any site with 0 posts in the cache is
#      re-scraped alone (no bulk re-scrape) via the per-site endpoint.
#   2. Ratio-based reverify â€” if any site has at least
#      RECENT_UNVERIFIED_TRIGGER unverified posts AND its
#      verified:unverified ratio is below RECENT_VERIFIED_RATIO, all
#      per-title negative caches are cleared and enrichment re-runs.
#
# Both actions are rate-limited by their respective cooldowns.
#
# Minimum unverified-post count on a single site that can trigger a
# reverify. Defaults to 10. Lower = more eager, higher = calmer.
# RECENT_UNVERIFIED_TRIGGER=10
# Minimum acceptable verified:unverified ratio for a site. Defaults to 2
# (i.e. at least twice as many verified as unverified posts). Match the
# ideal 20:1 by setting this to 20 â€” but any site with 10+ unverified and
# a ratio below this value is considered overloaded.
# RECENT_VERIFIED_RATIO=2
# Minimum milliseconds between per-site background refreshes. Defaults
# to 300000 (5m). The on-demand endpoint can bypass this with ?force=true.
# RECENT_SITE_REFRESH_COOLDOWN_MS=300000
# Minimum milliseconds between auto-reverify passes. Defaults to 300000
# (5m). The manual ?reverify=true query param on /api/games/recent
# bypasses this cooldown.
# RECENT_REVERIFY_COOLDOWN_MS=300000

# ðŸ“¦ Environment use development .env if youre developing!!
NODE_ENV=production

# ðŸ§¾ Logging (production defaults)
# Set to 'error' to only log errors, 'warn' to include warnings, 'info' for info, 'debug' for verbose
LOG_LEVEL=error
ENABLE_DEBUG_LOGS=false

# ðŸ”§ External APIs
# Steam API (now integrated - these are optional overrides)
# Defaults to /api/steam in production, http://localhost:3002/api/steam in development
# Only set these if you need to use a different endpoint
# NEXT_PUBLIC_STEAM_API_BASE=/api/steam
# STEAM_API_BASE=/api/steam
# NEXT_PUBLIC_APP_URL=http://localhost:3002  # For Node.js scripts/tests

# ðŸŽ® IGDB (Internet Game Database) - For unreleased games
# Get these from https://dev.twitch.tv/console (create an app and get Client ID and Secret)
# Used to find unreleased/upcoming games when they're not available on piracy sites yet
IGDB_CLIENT_ID=your-twitch-client-id
IGDB_CLIENT_SECRET=your-twitch-client-secret

# ðŸŽ® RAWG.io (Fallback game images when IGDB fails - 20k req/month free)
# Get a key from https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-api-key

# RSS: background fill of per-game `rssCachedDownloadLinks` (gameapi) for the feed
# Used by the in-process scheduler (long-lived Node) and optional GET cron.
# Scheduler warms at most 10 games per cycle (first/most stale in batch order). Optional: set lower (1–10).
# RSS_CACHE_WARM_MAX_PER_RUN=10
# RSS_CACHE_WARM_INTERVAL_MS=2700000
# Re-fetch cached links when older than N days (optional).
# RSS_CACHE_WARM_MAX_AGE_DAYS=7
# GET /api/rss/cache-download-links — shared secret (Bearer or ?secret=)
# RSS_DOWNLOAD_CACHE_CRON_SECRET=

# NAS/local library scanner
# The tracking page can scan this flat directory for game archives and mark
# tracked games that already exist locally. Prefer UNC paths on Windows services.
# Windows example: LIBRARY_ROOT=\\YourNAS\Games
# Linux/Docker example: LIBRARY_ROOT=/library/games
# LIBRARY_ROOT=/library/games
# Optional downloader/output folder. Archives here count as locally available
# immediately, even before they are moved into the canonical games directory.
# LIBRARY_DOWNLOAD_ROOT=/downloads/games
# Automatically rescan after the shared library changes. The settle delay
# avoids importing an archive while a downloader is still writing it.
LIBRARY_WATCH_ENABLED=true
LIBRARY_WATCH_SETTLE_MS=30000
# Polling catches filesystem events that some NAS mounts do not forward.
LIBRARY_WATCH_POLL_INTERVAL_MS=60000
LIBRARY_WATCH_SCAN_ON_START=true
# Opt in to deleting older archives during scans. Files are grouped by game
# title and ranked by the version/build parsed from the filename, falling back
# to modification time only when neither carries one; the newest two are kept.
# Extracted folders and multi-part sets are never deleted. Every configured
# library root that should be cleaned must be writable inside the container.
# Note that titles are normalised, so editions collapse into the base game
# (a Deluxe Edition counts as a version of the same title), and grouping spans
# every configured root.
LIBRARY_STALE_DELETE_ENABLED=false

# Optional CS.RIN.RU forum search. Search results scan recent matching threads
# and return only forum posts that contain external links.
# CSRIN_USERNAME=
# CSRIN_PASSWORD=
# Comma-separated forum members whose releases are trusted. Their posts are
# ranked above all other results (case-insensitive). e.g. CSRIN_RELIABLE_POSTERS=Owla
# CSRIN_RELIABLE_POSTERS=

# JD2 auto-downloads and status
# AIOgames adds, monitors, and removes JD2 jobs through the API. MyJDownloader
# credentials are tried first. If that connection is unavailable, JD2_API_URL
# is used as the local direct-API fallback.
JD2_AUTO_DOWNLOADS_ENABLED=true
MYJD_EMAIL=
MYJD_PASSWORD=
JD2_API_URL=http://jdownloader:3128
# Optional when the MyJDownloader account has multiple online devices.
JD2_DEVICE_ID=
JD2_DEVICE_NAME=JDownloader@Docker
# This path is resolved inside the JDownloader container (jlesage uses /output).
JD2_DOWNLOAD_ROOT=/output
JD2_AUTO_START=true
# Set true only when JD2_DOWNLOAD_ROOT should override Packagizer folder rules.
JD2_OVERWRITE_PACKAGIZER=false
JD2_HOST_PRIORITY=multiup,gofile,pixeldrain,mediafire,datanodes
JD2_MONITOR_INTERVAL_MS=60000
# Enable when JD2 removes successful packages from its download list. AIOgames
# then treats an observed, progressing package that disappears as completed.
JD2_REMOVES_FINISHED=false
# A non-running job with no byte progress for this long switches hosts.
JD2_STALL_MINUTES=15
# Time allowed for the API-added package to appear before one retry.
JD2_MISSING_JOB_MINUTES=10
# Captchas are surfaced for manual action by default. Enable this to switch to
# the next host after JD2_CAPTCHA_FALLBACK_MINUTES instead.
JD2_FALLBACK_ON_CAPTCHA=false
JD2_CAPTCHA_FALLBACK_MINUTES=30

# qBittorrent
# Magnet and .torrent links in the download window can be handed to a
# qBittorrent instance reachable from this container (same idea as
# FLARESOLVERR_URL - a service name on a shared docker network works).
# The button only appears when QBITTORRENT_URL is set and the link is actually
# a magnet or .torrent.
# QBITTORRENT_URL=http://qbittorrent:8080
# Omit both credentials if the WebUI has "Bypass authentication for clients on
# localhost / whitelisted subnets" enabled for this container.
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=
# Category assigned to every torrent added this way.
# QBIT_CATEGORY=games
# Comma-separated tags. The game title is appended as an extra tag so torrents
# are identifiable in qBittorrent; set QBIT_TAG_GAME_TITLE=false to stop that.
# QBIT_TAGS=aiogames
# QBIT_TAG_GAME_TITLE=true
# Optional. Leave unset to use whatever the category's save path is in qBit.
# QBIT_SAVE_PATH=
# Add torrents in a paused state instead of starting them.
# QBIT_ADD_PAUSED=false
